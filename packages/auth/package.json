{
  "name": "@cydo/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/core/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts"
  },
  "typesVersions": {
    "*": {
      "server": ["./src/server/index.ts"],
      "client": ["./src/client/index.ts"],
      "*": ["./src/core/index.ts"]
    }
  },
  "scripts": {
    "dev": "echo \"@cydo/auth has no dev server\"",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
