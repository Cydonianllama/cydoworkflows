NODE_ENV=development
PORT=4000

# ============ BASE DE DATOS (MongoDB / Mongoose) ============
MONGO_URI=mongodb://localhost:27017/portfoliov1?retryWrites=false
# Si se define, sobreescribe la base indicada en MONGO_URI.
MONGO_DB_NAME=cydoworkflow

# ============ APP ============
CORS_ORIGIN=http://localhost:5173
WEBAPP_URL=http://localhost:5173

# ============ SESIÓN ============
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso_min_16
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_min_16
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false

# ============ OTP ============
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DIGITS=6

# ============ GOOGLE OAUTH ============
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ============ RESEND (OTP verificación + invitaciones) ============
# Sin API key el OTP y los links de invitación se imprimen en consola.
RESEND_API_KEY=
RESEND_FROM=Cydonian Pro <flowapp@cydonianllama.com>

# ============ WORKFLOW ENGINE ============
# Cadencia del tick del scheduler de triggers cron (ms).
SCHEDULER_TICK_MS=30000
# Máximo de nodos que recorre el pipeline en una ejecución.
PIPELINE_MAX_STEPS=50
